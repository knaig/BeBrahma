# BeBrahma v0.3 API - Environment Configuration

# Environment
ENV=development  # development | staging | production

# API
API_HOST=0.0.0.0
API_PORT=3001
API_WORKERS=4

# Database
DATABASE_URL=postgresql+asyncpg://bebrahma:password@localhost:5432/bebrahma_v3
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis (Caching)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=300  # 5 minutes

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxx
CLERK_JWT_VERIFICATION_KEY_URL=https://clerk.com/.well-known/jwks.json

# LLM APIs
ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx

# LLM Configuration
LLM_TIER_CLASSIFICATION=gpt-3.5-turbo
LLM_TIER_REASONING=claude-sonnet-4-20250514
LLM_TIER_COMPLEX=claude-opus-4-5-20251101
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=10

# NBA Engine
NBA_COMPUTATION_TIMEOUT_SECONDS=3
NBA_MAX_CANDIDATES_PER_FRAMEWORK=20
NBA_CONFIDENCE_CALCULATION_TOP_N=10

# Integrations
GOOGLE_CALENDAR_CLIENT_ID=xxxxx
GOOGLE_CALENDAR_CLIENT_SECRET=xxxxx
LINEAR_CLIENT_ID=xxxxx
LINEAR_CLIENT_SECRET=xxxxx
ASANA_CLIENT_ID=xxxxx
ASANA_CLIENT_SECRET=xxxxx

# Monitoring
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR

# CORS
CORS_ORIGINS=http://localhost:3000,https://app.bebrahma.com
