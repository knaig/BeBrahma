// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkflowStep {
  PROBLEM_CAPTURE
  PROBLEM_CLARIFICATION
  SOLUTION_BRAINSTORM
  COMPETITOR_ANALYSIS
  SCA_ANALYSIS
  MVP_PLANNING
  TASK_GENERATION
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  PAST_DUE
  UNPAID
  TRIALING
}

enum LLMProvider {
  OPENAI
  ANTHROPIC
  AZURE
  GOOGLE
}

enum AgentRole {
  PM
  CEO
  CTO
  Growth
  Research
  Data
  Strategy
  DevOps
}

enum AgentStatus {
  speaking
  thinking
  listening
  idle
}

enum ExportType {
  PROJECT
  TASKS
  DOCUMENTATION
  ANALYTICS
}

enum ExportFormat {
  PDF
  MARKDOWN
  CSV
  JSON
  ZIP
}

enum FeedbackType {
  BUG_REPORT
  FEATURE_REQUEST
  GENERAL
  RATING
  SURVEY_RESPONSE
}

enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum DependencyType {
  BLOCKS
  RELATED
  SUBTASK
}

model ConversationSession {
  id        String   @id @default(cuid())
  userId    String
  sessionId String
  problem   String
  messages  Json[]   // Array of Message objects
  summary   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  metadata  Json     // Metadata object with insights, recommendations, etc.

  // Relations
  projects  Project[]

  @@unique([userId, sessionId])
  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
}

model Project {
  id               String       @id @default(cuid())
  userId           String
  name             String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  workflowStep     WorkflowStep @default(PROBLEM_CAPTURE)
  progress         Int          @default(0)
  conversationId   String?
  selectedSolution String?

  // Relations
  conversation     ConversationSession? @relation(fields: [conversationId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  problems        Problem[]
  solutions       Solution[]
  competitors     Competitor[]
  scaFactors      SCAFactor[]
  mvpFeatures     MVPFeature[]
  tasks           Task[]
  boards          Board[]

  @@index([createdAt])
  @@index([userId])
  @@index([workflowStep])
}

model Problem {
  id          String   @id @default(cuid())
  projectId   String
  rawInput    String
  clarifiedProblem String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  project     Project  @relation(fields: [projectId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([projectId])
}

model Solution {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  project     Project  @relation(fields: [projectId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([projectId])
}

model Competitor {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  strengths   String[]
  weaknesses  String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  project     Project  @relation(fields: [projectId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([projectId])
}

model SCAFactor {
  id           String   @id @default(cuid())
  projectId    String
  category     String
  factor       String
  description  String
  strength     String
  sustainability String
  evidence     String
  actionItems  String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  project      Project  @relation(fields: [projectId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([projectId])
}

model MVPFeature {
  id                String   @id @default(cuid())
  projectId         String
  name              String
  description       String?
  priority          String
  effort            String
  impact            String
  scaAlignment      String[]
  userStories       String[]
  acceptanceCriteria String[]
  estimatedTime     String?
  estimatedCost     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  project           Project  @relation(fields: [projectId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([projectId])
}

model Board {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  settings    Json?    // Board configuration options
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  project     Project  @relation(fields: [projectId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  tasks       Task[]

  @@index([projectId])
}

model Task {
  id              String     @id @default(cuid())
  projectId       String
  boardId         String?
  phaseId         String?    // Link to Playbook Phase (optional)
  title           String
  description     String?
  category        String
  priority        String
  status          TaskStatus @default(TODO)
  position        Int        @default(0)
  estimatedHours  Int?
  assigneeId      String?
  dueDate         DateTime?
  completedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations
  project         Project           @relation(fields: [projectId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  board           Board?            @relation(fields: [boardId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  phase           Phase?            @relation("PhaseTask", fields: [phaseId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  dependencies    TaskDependency[]  @relation("TaskDependencies")
  dependents      TaskDependency[]  @relation("DependentTasks")

  @@index([projectId])
  @@index([boardId])
  @@index([phaseId])
  @@index([status])
  @@index([assigneeId])
  @@index([dueDate])
}

model TaskDependency {
  id           String         @id @default(cuid())
  taskId       String
  dependsOnId  String
  type         DependencyType @default(BLOCKS)
  createdAt    DateTime       @default(now())

  // Relations
  task         Task           @relation("TaskDependencies", fields: [taskId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  dependsOn    Task           @relation("DependentTasks", fields: [dependsOnId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@index([taskId])
  @@index([dependsOnId])
}

model Subscription {
  id                     String            @id @default(cuid())
  userId                 String            @unique
  provider               PaymentProvider
  providerCustomerId     String
  providerSubscriptionId String
  status                 SubscriptionStatus
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean          @default(false)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  // Relations
  paymentMethods         PaymentMethod[]

  @@index([userId])
  @@index([status])
}

model PaymentMethod {
  id             String      @id @default(cuid())
  userId         String
  subscriptionId String
  provider       PaymentProvider
  providerMethodId String
  type           String      // 'card', 'bank_account', etc.
  last4          String?
  brand          String?
  isDefault      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relations
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([userId])
  @@index([subscriptionId])
}

model ApiKey {
  id           String      @id @default(cuid())
  userId       String
  provider     LLMProvider
  encryptedKey String      // AES-256-GCM encrypted API key
  iv           String      // Initialization vector for encryption
  keyAlias     String?     // User-friendly name for the key
  metadata     Json?       // Additional configuration (model preferences, etc.)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
}

model AgentPersona {
  id                String     @id @default(cuid())
  role              AgentRole
  name              String
  title             String
  department        String
  avatarUrl         String?
  colorHex          String
  speakingStyle     String
  defaultStatus     AgentStatus @default(idle)
  personalityTraits Json       // Object with traits like formality, enthusiasm, etc.
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // Relations
  agentSessions     AgentSession[]

  @@unique([role])
  @@index([role])
}

model AgentSession {
  id               String      @id @default(cuid())
  sessionId        String
  agentId          String
  currentStatus    AgentStatus @default(idle)
  lastActivity     DateTime    @default(now())
  metadata         Json?       // Additional session-specific data
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  agent            AgentPersona @relation(fields: [agentId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@unique([sessionId, agentId])
  @@index([sessionId])
  @@index([agentId])
  @@index([currentStatus])
}

model ExportRecord {
  id        String      @id @default(cuid())
  userId    String
  exportId  String      @unique
  type      ExportType
  format    ExportFormat
  filename  String
  filePath  String
  size      Int
  expiresAt DateTime
  metadata  Json?       // Additional export configuration
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@index([exportId])
  @@index([expiresAt])
  @@index([createdAt])
}

model Feedback {
  id          String         @id @default(cuid())
  userId      String
  type        FeedbackType
  rating      Int?           // 1-5 scale for ratings
  title       String
  description String?
  metadata    Json?          // Survey responses, additional context
  status      FeedbackStatus @default(OPEN)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([rating])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?  // Nullable for anonymous events
  sessionId String
  eventType String   // page_view, button_click, feature_used, etc.
  eventData Json     // Event-specific data
  timestamp DateTime @default(now())
  metadata  Json?    // Additional context (user agent, referrer, etc.)

  @@index([userId])
  @@index([sessionId])
  @@index([eventType])
  @@index([timestamp])
}

model UsageMetrics {
  id            String   @id @default(cuid())
  userId        String
  date          DateTime // Date for daily aggregation
  sessionsCount Int      @default(0)
  messagesCount Int      @default(0)
  toolsUsed     Json     @default("[]") // Array of tool names
  timeSpent     Int      @default(0)    // Time in minutes
  featuresUsed  Json     @default("[]") // Array of feature names
  createdAt     DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([createdAt])
}

// ============================================================================
// BUSINESS IDE CORE MODELS
// ============================================================================

// Workspace: Top-level container for Business IDE artifacts
model Workspace {
  id          String   @id @default(cuid())
  userId      String
  slug        String   @unique
  name        String
  description String?
  objectives  String[]
  constraints String[]
  status      String   @default("active") // active, archived, completed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  artifacts    Artifact[]
  playbooks    Playbook[]
  scoreboards  Scoreboard[]

  @@index([userId])
  @@index([slug])
  @@index([status])
  @@index([createdAt])
}

enum ArtifactType {
  PLAYBOOK
  PILOT_PACK
  PRD
  PITCH
  OUTREACH_EMAIL
  MODEL_SHEET
  MEETING_NOTES
  CONTRACT
  RESEARCH_NOTE
  DESIGN_DOC
  TEST_PLAN
  OTHER
}

enum ArtifactStatus {
  DRAFT
  REVIEW
  APPROVED
  SENT
  SIGNED
  ARCHIVED
}

// Artifact: Versioned documents with metadata and lineage
model Artifact {
  id          String         @id @default(cuid())
  workspaceId String
  title       String
  type        ArtifactType
  status      ArtifactStatus @default(DRAFT)
  version     Int            @default(1)
  content     String         @db.Text // Main content
  contentHash String         // SHA-256 hash for de-duplication
  storagePath String?        // Local or cloud storage path
  storageUrl  String?        // Public URL if applicable

  // Metadata
  tags        String[]
  createdBy   String
  source      String?        // e.g., "prompt:xyz", "manual", "workflow:abc"

  // Lineage tracking
  parentId    String?        // Parent artifact for versioning
  lineage     Json           @default("[]") // Array of ancestor artifact IDs

  // Search optimization
  searchVector String?       @db.Text // Postgres tsvector stored as text

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  parent      Artifact?      @relation("ArtifactVersions", fields: [parentId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  children    Artifact[]     @relation("ArtifactVersions")

  @@index([workspaceId])
  @@index([type])
  @@index([status])
  @@index([createdBy])
  @@index([parentId])
  @@index([contentHash])
  @@index([createdAt])
  @@index([updatedAt])
}

// Playbook: Phased project execution plan
model Playbook {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  isTemplate  Boolean  @default(false)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  phases      Phase[]

  @@index([workspaceId])
  @@index([isTemplate])
  @@index([createdBy])
}

// Phase: Stage in a playbook
model Phase {
  id          String   @id @default(cuid())
  playbookId  String
  name        String
  description String?
  order       Int      // Sequence order
  status      String   @default("pending") // pending, active, completed, blocked
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  playbook    Playbook @relation(fields: [playbookId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  gates       Gate[]
  tasks       Task[]   @relation("PhaseTask")

  @@index([playbookId])
  @@index([order])
  @@index([status])
}

enum GateCheckType {
  ARTIFACT_EXISTS
  METRIC_THRESHOLD
  CHECKLIST_COMPLETE
  MANUAL_APPROVAL
  TASK_COMPLETION
}

// Gate: Checkpoint that must pass before proceeding
model Gate {
  id          String       @id @default(cuid())
  phaseId     String
  name        String
  description String?
  checkType   GateCheckType
  checkConfig Json         // Configuration for the check (artifact ID, metric threshold, etc.)
  blocking    Boolean      @default(true)
  status      String       @default("pending") // pending, passed, failed
  lastChecked DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  phase       Phase        @relation(fields: [phaseId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([phaseId])
  @@index([status])
  @@index([checkType])
}

// Scoreboard: KPI dashboard for a workspace
model Scoreboard {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  cadence     String   @default("weekly") // daily, weekly, monthly
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  metrics        Metric[]
  weeklyReviews  WeeklyReview[]

  @@index([workspaceId])
  @@index([createdBy])
}

// Metric: Individual KPI definition
model Metric {
  id           String   @id @default(cuid())
  scoreboardId String
  name         String
  definition   String
  unit         String
  target       Float?
  threshold    Float?   // Warning threshold
  dataSource   String?  // How to collect this metric
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  scoreboard   Scoreboard       @relation(fields: [scoreboardId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  snapshots    MetricSnapshot[]

  @@index([scoreboardId])
}

// MetricSnapshot: Time-series data for metrics
model MetricSnapshot {
  id        String   @id @default(cuid())
  metricId  String
  value     Float
  timestamp DateTime @default(now())
  metadata  Json?    // Additional context

  // Relations
  metric    Metric   @relation(fields: [metricId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([metricId])
  @@index([timestamp])
}

// WeeklyReview: Weekly retrospective with decisions and experiments
model WeeklyReview {
  id              String   @id @default(cuid())
  scoreboardId    String
  weekNumber      Int      // ISO week number
  year            Int
  summary         String   @db.Text
  achievements    String[]
  challenges      String[]
  decisions       Json     @default("[]") // Array of decision objects
  nextExperiments Json     @default("[]") // Array of experiment objects
  failureTaxonomy Json     @default("{}") // Categorized failures: {category: count}
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  scoreboard      Scoreboard @relation(fields: [scoreboardId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@unique([scoreboardId, year, weekNumber])
  @@index([scoreboardId])
  @@index([year])
  @@index([weekNumber])
  @@index([createdBy])
}

// ============================================================================
// DECISION OS - REVENUE LOOP WEDGE
// ============================================================================

enum EvidenceRung {
  SYNTHETIC
  ATTENTION
  INTENT
  COMMITMENT
  RETENTION
}

enum DirectionStatus {
  PENDING
  FUNDED
  DEFERRED
  KILLED
}

enum ExperimentStatus {
  DRAFT
  QUEUED
  RUNNING
  PASSED
  FAILED
  ABANDONED
}

enum ExperimentGateType {
  EVIDENCE_THRESHOLD
  ARTIFACT_REQUIRED
  METRIC_THRESHOLD
  MANUAL_APPROVAL
}

enum SpeedMode {
  FAST
  SLOW
}

enum FounderProfile {
  SPRINTER
  PERFECTIONIST
  BALANCED
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

// Venture: Solo founder's business venture
model Venture {
  id                  String         @id @default(cuid())
  userId              String
  name                String
  stage               String         @default("customer_discovery") // customer_discovery, offer, pipeline, first_revenue

  // Budgets
  hoursPerWeek        Int            @default(20)
  sendsPerWeek        Int            @default(100)
  spendPerWeek        Int            @default(500)

  // WIP Limits
  maxDirections       Int            @default(3)
  maxActiveExperiments Int           @default(1)

  // Profile & Settings
  founderProfile      FounderProfile @default(BALANCED)
  experienceVariant   String         @default("command_center") // command_center, in_tools

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Relations
  directions          Direction[]
  experiments         DecisionExperiment[]
  evidence            DecisionEvidence[]
  decisions           DecisionEvent[]
  overrides           OverrideEvent[]
  integrations        Integration[]

  @@index([userId])
  @@index([stage])
  @@index([createdAt])
}

// Direction: Business direction/opportunity to explore
model Direction {
  id                  String         @id @default(cuid())
  ventureId           String

  // Direction Vector
  icp                 String         // Who
  problem             String         // What pain
  offer               String         // Solution
  channel             String         // How to reach
  price               String         // Price point

  // State
  status              DirectionStatus @default(PENDING)
  currentRung         EvidenceRung   @default(SYNTHETIC)
  confidenceScore     Int            @default(0) // 0-100
  expectedValue       Int            @default(0) // 0-100

  // Budget Allocation
  allocatedHours      Int            @default(0)
  allocatedSends      Int            @default(0)
  allocatedSpend      Int            @default(0)

  // Kill Criteria
  killCriteria        String[]

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Relations
  venture             Venture        @relation(fields: [ventureId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  experiments         DecisionExperiment[]
  evidence            DecisionEvidence[]
  decisions           DecisionEvent[]

  @@index([ventureId])
  @@index([status])
  @@index([currentRung])
  @@index([createdAt])
}

// DecisionExperiment: Experiments to validate directions
model DecisionExperiment {
  id                  String         @id @default(cuid())
  directionId         String
  ventureId           String

  title               String
  hypothesis          String         @db.Text
  approach            String         @db.Text

  status              ExperimentStatus @default(DRAFT)
  targetRung          EvidenceRung

  // Decision Grading
  grade               Int            // 0-3
  speedMode           SpeedMode      @default(FAST)

  // Cost Estimation
  estimatedHours      Int            @default(0)
  estimatedSends      Int            @default(0)
  estimatedSpend      Int            @default(0)

  // Timeline
  startedAt           DateTime?
  completedAt         DateTime?

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Relations
  venture             Venture        @relation(fields: [ventureId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  direction           Direction      @relation(fields: [directionId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  gates               ExperimentGate[]
  evidence            DecisionEvidence[]

  @@index([ventureId])
  @@index([directionId])
  @@index([status])
  @@index([grade])
  @@index([targetRung])
  @@index([createdAt])
}

// ExperimentGate: Pass/fail criteria for experiments
model ExperimentGate {
  id                  String         @id @default(cuid())
  experimentId        String
  order               Int            // Sequential evaluation order

  type                ExperimentGateType
  description         String
  condition           Json           // JSON rule for evaluation

  status              String         @default("pending") // pending, passed, failed
  evaluatedAt         DateTime?
  evaluationResult    Json?

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Relations
  experiment          DecisionExperiment @relation(fields: [experimentId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([experimentId])
  @@index([order])
  @@index([status])
}

// DecisionEvidence: Evidence collected from experiments
model DecisionEvidence {
  id                  String         @id @default(cuid())
  ventureId           String
  directionId         String
  experimentId        String?

  rung                EvidenceRung
  type                String         // interview, email_reply, signup, payment, etc.
  description         String         @db.Text
  data                Json           @default("{}")

  source              String         // manual, gmail, stripe, etc.
  sourceId            String?        // External ID from integration

  createdAt           DateTime       @default(now())

  // Relations
  venture             Venture        @relation(fields: [ventureId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  direction           Direction      @relation(fields: [directionId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  experiment          DecisionExperiment? @relation(fields: [experimentId], references: [id], onUpdate: Cascade, onDelete: SetNull)

  @@index([ventureId])
  @@index([directionId])
  @@index([experimentId])
  @@index([rung])
  @@index([source])
  @@index([createdAt])
}

// DecisionEvent: Fund/Modify/Defer/Kill decisions
model DecisionEvent {
  id                  String         @id @default(cuid())
  ventureId           String
  directionId         String

  actionType          String         // fund, modify, defer, kill
  reason              String         @db.Text

  // Context at time of decision
  confidenceScore     Int
  expectedValue       Int
  currentRung         EvidenceRung

  userId              String
  createdAt           DateTime       @default(now())

  // Relations
  venture             Venture        @relation(fields: [ventureId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  direction           Direction      @relation(fields: [directionId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([ventureId])
  @@index([directionId])
  @@index([actionType])
  @@index([createdAt])
}

// OverrideEvent: Soft friction overrides
model OverrideEvent {
  id                  String         @id @default(cuid())
  ventureId           String
  entityId            String         // experimentId or directionId
  entityType          String         // experiment, direction

  grade               Int
  mode                SpeedMode
  actionType          String
  recommendedAction   String
  reason              String         @db.Text // Why they overrode (min 10 chars)

  userId              String
  createdAt           DateTime       @default(now())

  // Relations
  venture             Venture        @relation(fields: [ventureId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([ventureId])
  @@index([entityId])
  @@index([entityType])
  @@index([createdAt])
}

// Integration: Connected tools for evidence capture
model Integration {
  id                  String         @id @default(cuid())
  ventureId           String
  userId              String

  provider            String         // google_workspace, hubspot, stripe, github
  providerType        String         // google_workspace, crm, payment, repo
  status              IntegrationStatus @default(DISCONNECTED)

  // OAuth tokens (encrypted)
  accessToken         String?        @db.Text
  refreshToken        String?        @db.Text
  tokenExpiry         DateTime?

  // Configuration
  config              Json           @default("{}")  // Provider-specific config (filters, repos, etc.)

  // Metadata
  lastSyncAt          DateTime?
  errorMessage        String?

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Relations
  venture             Venture        @relation(fields: [ventureId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@unique([ventureId, provider])
  @@index([ventureId])
  @@index([userId])
  @@index([provider])
  @@index([status])
}
