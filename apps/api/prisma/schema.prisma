// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkflowStep {
  PROBLEM_CAPTURE
  PROBLEM_CLARIFICATION
  SOLUTION_BRAINSTORM
  COMPETITOR_ANALYSIS
  SCA_ANALYSIS
  MVP_PLANNING
  TASK_GENERATION
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  PAST_DUE
  UNPAID
  TRIALING
}

enum LLMProvider {
  OPENAI
  ANTHROPIC
  AZURE
  GOOGLE
}

enum AgentRole {
  PM
  CEO
  CTO
  Growth
  Research
  Data
  Strategy
  DevOps
}

enum AgentStatus {
  speaking
  thinking
  listening
  idle
}

enum ExportType {
  PROJECT
  TASKS
  DOCUMENTATION
  ANALYTICS
}

enum ExportFormat {
  PDF
  MARKDOWN
  CSV
  JSON
  ZIP
}

enum FeedbackType {
  BUG_REPORT
  FEATURE_REQUEST
  GENERAL
  RATING
  SURVEY_RESPONSE
}

enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum DependencyType {
  BLOCKS
  RELATED
  SUBTASK
}

model ConversationSession {
  id        String   @id @default(cuid())
  userId    String
  sessionId String
  problem   String
  messages  Json[]   // Array of Message objects
  summary   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  metadata  Json     // Metadata object with insights, recommendations, etc.

  // Relations
  projects  Project[]

  @@unique([userId, sessionId])
  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
}

model Project {
  id               String       @id @default(cuid())
  userId           String
  name             String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  workflowStep     WorkflowStep @default(PROBLEM_CAPTURE)
  progress         Int          @default(0)
  conversationId   String?
  selectedSolution String?

  // Relations
  conversation     ConversationSession? @relation(fields: [conversationId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  problems        Problem[]
  solutions       Solution[]
  competitors     Competitor[]
  scaFactors      SCAFactor[]
  mvpFeatures     MVPFeature[]
  tasks           Task[]
  boards          Board[]

  @@index([createdAt])
  @@index([userId])
  @@index([workflowStep])
}

model Problem {
  id          String   @id @default(cuid())
  projectId   String
  rawInput    String
  clarifiedProblem String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  project     Project  @relation(fields: [projectId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([projectId])
}

model Solution {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  project     Project  @relation(fields: [projectId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([projectId])
}

model Competitor {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  strengths   String[]
  weaknesses  String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  project     Project  @relation(fields: [projectId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([projectId])
}

model SCAFactor {
  id           String   @id @default(cuid())
  projectId    String
  category     String
  factor       String
  description  String
  strength     String
  sustainability String
  evidence     String
  actionItems  String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  project      Project  @relation(fields: [projectId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([projectId])
}

model MVPFeature {
  id                String   @id @default(cuid())
  projectId         String
  name              String
  description       String?
  priority          String
  effort            String
  impact            String
  scaAlignment      String[]
  userStories       String[]
  acceptanceCriteria String[]
  estimatedTime     String?
  estimatedCost     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  project           Project  @relation(fields: [projectId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([projectId])
}

model Board {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  settings    Json?    // Board configuration options
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  project     Project  @relation(fields: [projectId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  tasks       Task[]

  @@index([projectId])
}

model Task {
  id              String     @id @default(cuid())
  projectId       String
  boardId         String?
  title           String
  description     String?
  category        String
  priority        String
  status          TaskStatus @default(TODO)
  position        Int        @default(0)
  estimatedHours  Int?
  assigneeId      String?
  dueDate         DateTime?
  completedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations
  project         Project           @relation(fields: [projectId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  board           Board?            @relation(fields: [boardId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  dependencies    TaskDependency[]  @relation("TaskDependencies")
  dependents      TaskDependency[]  @relation("DependentTasks")

  @@index([projectId])
  @@index([boardId])
  @@index([status])
  @@index([assigneeId])
  @@index([dueDate])
}

model TaskDependency {
  id           String         @id @default(cuid())
  taskId       String
  dependsOnId  String
  type         DependencyType @default(BLOCKS)
  createdAt    DateTime       @default(now())

  // Relations
  task         Task           @relation("TaskDependencies", fields: [taskId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  dependsOn    Task           @relation("DependentTasks", fields: [dependsOnId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@index([taskId])
  @@index([dependsOnId])
}

model Subscription {
  id                     String            @id @default(cuid())
  userId                 String            @unique
  provider               PaymentProvider
  providerCustomerId     String
  providerSubscriptionId String
  status                 SubscriptionStatus
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean          @default(false)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  // Relations
  paymentMethods         PaymentMethod[]

  @@index([userId])
  @@index([status])
}

model PaymentMethod {
  id             String      @id @default(cuid())
  userId         String
  subscriptionId String
  provider       PaymentProvider
  providerMethodId String
  type           String      // 'card', 'bank_account', etc.
  last4          String?
  brand          String?
  isDefault      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relations
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([userId])
  @@index([subscriptionId])
}

model ApiKey {
  id           String      @id @default(cuid())
  userId       String
  provider     LLMProvider
  encryptedKey String      // AES-256-GCM encrypted API key
  iv           String      // Initialization vector for encryption
  keyAlias     String?     // User-friendly name for the key
  metadata     Json?       // Additional configuration (model preferences, etc.)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
}

model AgentPersona {
  id                String     @id @default(cuid())
  role              AgentRole
  name              String
  title             String
  department        String
  avatarUrl         String?
  colorHex          String
  speakingStyle     String
  defaultStatus     AgentStatus @default(idle)
  personalityTraits Json       // Object with traits like formality, enthusiasm, etc.
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // Relations
  agentSessions     AgentSession[]

  @@unique([role])
  @@index([role])
}

model AgentSession {
  id               String      @id @default(cuid())
  sessionId        String
  agentId          String
  currentStatus    AgentStatus @default(idle)
  lastActivity     DateTime    @default(now())
  metadata         Json?       // Additional session-specific data
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  agent            AgentPersona @relation(fields: [agentId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@unique([sessionId, agentId])
  @@index([sessionId])
  @@index([agentId])
  @@index([currentStatus])
}

model ExportRecord {
  id        String      @id @default(cuid())
  userId    String
  exportId  String      @unique
  type      ExportType
  format    ExportFormat
  filename  String
  filePath  String
  size      Int
  expiresAt DateTime
  metadata  Json?       // Additional export configuration
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@index([exportId])
  @@index([expiresAt])
  @@index([createdAt])
}

model Feedback {
  id          String         @id @default(cuid())
  userId      String
  type        FeedbackType
  rating      Int?           // 1-5 scale for ratings
  title       String
  description String?
  metadata    Json?          // Survey responses, additional context
  status      FeedbackStatus @default(OPEN)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([rating])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?  // Nullable for anonymous events
  sessionId String
  eventType String   // page_view, button_click, feature_used, etc.
  eventData Json     // Event-specific data
  timestamp DateTime @default(now())
  metadata  Json?    // Additional context (user agent, referrer, etc.)

  @@index([userId])
  @@index([sessionId])
  @@index([eventType])
  @@index([timestamp])
}

model UsageMetrics {
  id            String   @id @default(cuid())
  userId        String
  date          DateTime // Date for daily aggregation
  sessionsCount Int      @default(0)
  messagesCount Int      @default(0)
  toolsUsed     Json     @default("[]") // Array of tool names
  timeSpent     Int      @default(0)    // Time in minutes
  featuresUsed  Json     @default("[]") // Array of feature names
  createdAt     DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([createdAt])
}
