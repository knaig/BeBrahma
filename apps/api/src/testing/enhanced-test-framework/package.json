{
  "name": "bebrahma-enhanced-testing",
  "version": "1.0.0",
  "description": "Enhanced testing framework for CrewAI conversation testing with iterative cycles",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:cycle": "ts-node src/cycle-runner.ts",
    "test:generate": "ts-node src/test-generator.ts",
    "test:compare": "ts-node src/competitor-comparison.ts",
    "test:report": "ts-node src/report-generator.ts",
    "playwright:install": "playwright install",
    "playwright:test": "playwright test",
    "playwright:ui": "playwright test --ui"
  },
  "dependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.0",
    "@playwright/test": "^1.40.0",
    "openai": "^4.0.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.0",
    "chalk": "^5.3.0",
    "ora": "^7.0.0",
    "inquirer": "^9.2.0",
    "fs-extra": "^11.1.0",
    "moment": "^2.29.4"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.0",
    "@types/moment": "^2.13.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.ts", "**/*.test.ts"],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "html"],
    "setupFilesAfterEnv": ["<rootDir>/src/setup.ts"]
  }
}
