# BeBrahma Enhanced Testing Framework Environment Configuration

# Required: OpenAI API key for conversation evaluation
OPENAI_API_KEY=your_openai_api_key_here

# Required: CrewAI service endpoint
CREWAI_ENDPOINT=http://localhost:3001

# Optional: Competitor API keys for benchmarking
PERPLEXITY_API_KEY=your_perplexity_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here
GPT4_API_KEY=your_gpt4_api_key_here

# Optional: Test configuration overrides
TEST_TIMEOUT=300000
MAX_CONCURRENT_TESTS=3
OUTPUT_DIRECTORY=./test-results
