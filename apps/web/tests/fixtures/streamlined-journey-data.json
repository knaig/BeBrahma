  "errorConditions": {
    "networkErrors": {
      "timeout": {
        "name": "Request Timeout",
        "statusCode": 408,
        "message": "Request timed out",
        "recoveryAction": "retry-with-backoff",
        "userMessage": "The request is taking longer than expected. Please try again."
      },
      "connectionLost": {
        "name": "Connection Lost",
        "statusCode": 0,
        "message": "Network connection lost",
        "recoveryAction": "reconnect-and-retry",
        "userMessage": "Network connection lost. Please check your internet connection and try again."
      },
      "serverUnavailable": {
        "name": "Server Unavailable",
        "statusCode": 503,
        "message": "Service temporarily unavailable",
        "recoveryAction": "retry-later",
        "userMessage": "Service is temporarily unavailable. Please try again in a few minutes."
      }
    },
    "validationErrors": {
      "requiredField": {
        "name": "Required Field Missing",
        "statusCode": 400,
        "message": "Required field is missing",
        "recoveryAction": "fill-required-field",
        "userMessage": "Please fill in all required fields before continuing."
      },
      "invalidFormat": {
        "name": "Invalid Format",
        "statusCode": 400,
        "message": "Invalid data format",
        "recoveryAction": "correct-format",
        "userMessage": "Please check the format of your input and try again."
      },
      "businessRule": {
        "name": "Business Rule Violation",
        "statusCode": 400,
        "message": "Business rule violation",
        "recoveryAction": "adjust-business-logic",
        "userMessage": "Your request cannot be processed due to business rules. Please contact support."
      }
    },
    "serverErrors": {
      "internalError": {
        "name": "Internal Server Error",
        "statusCode": 500,
        "message": "Internal server error",
        "recoveryAction": "retry-or-contact-support",
        "userMessage": "An unexpected error occurred. Please try again or contact support if the problem persists."
      },
      "notImplemented": {
        "name": "Not Implemented",
        "statusCode": 501,
        "message": "Feature not implemented",
        "recoveryAction": "use-alternative-method",
        "userMessage": "This feature is not yet available. Please use an alternative method."
      },
      "serviceUnavailable": {
        "name": "Service Unavailable",
        "statusCode": 503,
        "message": "Service unavailable",
        "recoveryAction": "retry-later",
        "userMessage": "This service is currently unavailable. Please try again later."
      }
    }
