  "vendorPrefixes": {
    "cssProperties": [
      {
        "property": "display",
        "values": ["flex", "grid"],
        "prefixes": {
          "webkit": ["-webkit-flex", "-webkit-grid"],
          "moz": ["-moz-flex", "-moz-grid"],
          "ms": ["-ms-flex", "-ms-grid"]
        }
      },
      {
        "property": "transform",
        "values": ["translateX", "translateY", "rotate", "scale"],
        "prefixes": {
          "webkit": ["-webkit-transform"],
          "moz": ["-moz-transform"],
          "ms": ["-ms-transform"]
        }
      },
      {
        "property": "transition",
        "values": ["all", "opacity", "transform"],
        "prefixes": {
          "webkit": ["-webkit-transition"],
          "moz": ["-moz-transition"],
          "ms": ["-ms-transition"]
        }
      }
    ]
  },
