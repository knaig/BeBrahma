# Preview Environment (Early Adopters)
NEXT_PUBLIC_ENV=preview
NEXT_PUBLIC_API_URL=https://bebrahma.fly.dev
NEXT_PUBLIC_APP_URL=https://bebrahma-preview.vercel.app
NEXT_PUBLIC_APP_NAME=BeBrahma Preview

# Preview API Keys (use staging keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_preview_key_here
CLERK_SECRET_KEY=sk_test_your_preview_secret_here

# Preview URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Preview Features
NEXT_PUBLIC_ENABLE_DEBUG=true
NEXT_PUBLIC_ENABLE_LOGGING=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_FEATURE_FLAGS=early_adopter_features
