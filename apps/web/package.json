{
  "name": "@bebrahma/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently \"pnpm --filter @bebrahma/api dev\" \"pnpm --filter @bebrahma/workflow-service dev\" \"pnpm --filter @bebrahma/web dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "playwright test && jest --config jest.config.api.js",
    "test:ui": "playwright test",
    "test:api": "jest --config jest.config.api.js",
    "test:api:watch": "jest --config jest.config.api.js --watch",
    "test:api:coverage": "jest --config jest.config.api.js --coverage",
    "test:integration": "jest --config jest.config.api.js --testPathPattern=integration",
    "test:timeout": "jest --config jest.config.api.js --testPathPattern=timeout-handling",
    "test:network": "jest --config jest.config.api.js --testPathPattern=network-failures",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "test:responsive": "playwright test tests/theme-responsiveness.spec.ts",
    "test:theme": "playwright test tests/theme-responsiveness.spec.ts",
    "test:playwright": "playwright test tests/component-integration.spec.ts",
    "test:langgraph": "playwright test tests/langgraph-*.spec.ts",
    "test:langgraph:watch": "playwright test tests/langgraph-*.spec.ts --watch",
    "test:workflow": "playwright test tests/langgraph-workflow-integration.spec.ts tests/workflow-*.spec.ts",
    "test:workflow:unit": "vitest run tests/langgraph-client.test.ts",
    "test:workflow:integration": "playwright test tests/langgraph-workflow-integration.spec.ts",
    "test:workflow:e2e": "playwright test tests/workflow-*.spec.ts --headed",
    "test:workflow:coverage": "vitest run --coverage tests/langgraph-client.test.ts",
    "test:persistence": "playwright test tests/workflow-persistence-recovery.spec.ts",
    "test:error-handling": "playwright test tests/workflow-error-handling.spec.ts",
    "test:chat-enhanced": "playwright test tests/chat-interface-enhanced.spec.ts",
    "test:langgraph:debug": "playwright test tests/langgraph-*.spec.ts --debug",
    "test:crewai": "playwright test tests/crewai-*.spec.ts tests/agent-*.spec.ts tests/real-time-agent-*.spec.ts",
    "test:crewai:debug": "playwright test tests/crewai-*.spec.ts tests/agent-*.spec.ts --debug",
    "test:crewai:headed": "playwright test tests/crewai-*.spec.ts tests/agent-*.spec.ts --headed",
    "test:agents": "playwright test tests/agent-communication-patterns.spec.ts tests/real-time-agent-status.spec.ts",
    "test:agents:watch": "playwright test tests/agent-communication-patterns.spec.ts tests/real-time-agent-status.spec.ts --watch",
    "test:workflow:decisions": "playwright test tests/workflow-decision-handling.spec.ts",
    "test:workflow:decisions:debug": "playwright test tests/workflow-decision-handling.spec.ts --debug",
    "test:session:recovery": "playwright test tests/session-continuity-recovery.spec.ts",
    "test:session:recovery:debug": "playwright test tests/session-continuity-recovery.spec.ts --debug",
    "test:backend:integration": "playwright test tests/backend-api-integration.spec.ts",
    "test:backend:integration:debug": "playwright test tests/backend-api-integration.spec.ts --debug",
    "test:multi-agent": "playwright test tests/crewai-multi-agent-coordination.spec.ts tests/agent-communication-patterns.spec.ts",
    "test:multi-agent:debug": "playwright test tests/crewai-multi-agent-coordination.spec.ts tests/agent-communication-patterns.spec.ts --debug",
    "test:coordination": "playwright test tests/crewai-multi-agent-coordination.spec.ts",
    "test:coordination:watch": "playwright test tests/crewai-multi-agent-coordination.spec.ts --watch",
    "test:real-time": "playwright test tests/real-time-agent-status.spec.ts",
    "test:real-time:debug": "playwright test tests/real-time-agent-status.spec.ts --debug",
    "test:crewai:full": "playwright test tests/crewai-*.spec.ts tests/agent-*.spec.ts tests/real-time-*.spec.ts tests/workflow-decision-*.spec.ts tests/session-*.spec.ts tests/backend-*.spec.ts",
    "test:crewai:performance": "playwright test tests/crewai-*.spec.ts tests/agent-*.spec.ts --repeat-each=3 --workers=1",
    "test:crewai:watch": "playwright test tests/crewai-*.spec.ts tests/agent-*.spec.ts --watch",
    "test:agents:patterns": "playwright test tests/agent-communication-patterns.spec.ts",
    "test:backend:agents": "playwright test tests/backend-api-integration.spec.ts tests/agent-*.spec.ts",
    "test:workflow:verbose": "playwright test tests/workflow-*.spec.ts --reporter=verbose",
    "test:agents:performance": "playwright test tests/agent-*.spec.ts --repeat-each=3 --workers=1",
    "test:workflow:load": "playwright test tests/workflow-*.spec.ts --repeat-each=5 --workers=2",
    "test:session:memory": "playwright test tests/session-*.spec.ts --reporter=verbose --trace=on",
    "test:agents:coverage": "playwright test tests/agent-*.spec.ts --reporter=html",
    "test:all": "playwright test && jest --config jest.config.api.js && vitest run tests/langgraph-client.test.ts",
    "test:cross-browser": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:cross-browser:chrome": "playwright test --project=chromium",
    "test:cross-browser:firefox": "playwright test --project=firefox",
    "test:cross-browser:safari": "playwright test --project=webkit",
    "test:cross-browser:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:performance:core-web-vitals": "playwright test tests/advanced-performance-monitoring.spec.ts --project=chromium",
    "test:performance:memory": "playwright test tests/advanced-performance-monitoring.spec.ts --grep='Memory' --project=chromium",
    "test:performance:network": "playwright test tests/advanced-performance-monitoring.spec.ts --grep='Network' --project=chromium",
    "test:performance:load": "playwright test tests/advanced-performance-monitoring.spec.ts --grep='Load' --project=chromium",
    "test:responsive:mobile": "playwright test tests/comprehensive-responsive-testing.spec.ts --project='Mobile Chrome' --project='Mobile Safari'",
    "test:responsive:tablet": "playwright test tests/comprehensive-responsive-testing.spec.ts --project=webkit",
    "test:responsive:desktop": "playwright test tests/comprehensive-responsive-testing.spec.ts --project=chromium --project=firefox",
    "test:responsive:breakpoints": "playwright test tests/comprehensive-responsive-testing.spec.ts --grep='Breakpoint'",
    "test:websocket": "playwright test tests/websocket-realtime-features.spec.ts --project=chromium",
    "test:websocket:connection": "playwright test tests/websocket-realtime-features.spec.ts --grep='Connection' --project=chromium",
    "test:websocket:messaging": "playwright test tests/websocket-realtime-features.spec.ts --grep='Messaging' --project=chromium",
    "test:websocket:reconnection": "playwright test tests/websocket-realtime-features.spec.ts --grep='Reconnection' --project=chromium",
    "test:realtime:features": "playwright test tests/websocket-realtime-features.spec.ts --grep='Real-time' --project=chromium",
    "test:realtime:performance": "playwright test tests/websocket-realtime-features.spec.ts --grep='Performance' --project=chromium",
    "test:realtime:load": "playwright test tests/websocket-realtime-features.spec.ts --grep='Load' --project=chromium",
    "test:compatibility": "playwright test tests/cross-browser-compatibility.spec.ts --project=chromium --project=firefox --project=webkit",
    "test:compatibility:features": "playwright test tests/cross-browser-compatibility.spec.ts --grep='Feature'",
    "test:compatibility:ui": "playwright test tests/cross-browser-compatibility.spec.ts --grep='UI'",
    "test:compatibility:performance": "playwright test tests/cross-browser-compatibility.spec.ts --grep='Performance'",
    "test:comprehensive": "npm run test:cross-browser && npm run test:performance:core-web-vitals && npm run test:responsive:desktop && npm run test:websocket && npm run test:compatibility",
    "test:e2e:architecture": "playwright test tests/end-to-end-architecture-integration.spec.ts",
    "test:e2e:chatinterface": "playwright test tests/unified-chatinterface-validation.spec.ts",
    "test:e2e:data-consistency": "playwright test tests/data-consistency-session-persistence.spec.ts",
    "test:e2e:error-recovery": "playwright test tests/error-recovery-resilience.spec.ts",
    "test:e2e:performance": "playwright test tests/performance-realtime-features.spec.ts",
    "test:e2e:all": "playwright test tests/end-to-end-*.spec.ts",
    "test:e2e:integration": "playwright test tests/end-to-end-architecture-integration.spec.ts tests/unified-chatinterface-validation.spec.ts",
    "test:e2e:resilience": "playwright test tests/error-recovery-resilience.spec.ts tests/data-consistency-session-persistence.spec.ts",
    "test:e2e:performance-full": "playwright test tests/performance-realtime-features.spec.ts --repeat-each=3 --workers=1",
    "test:e2e:cross-browser": "playwright test tests/end-to-end-*.spec.ts --project=chromium --project=firefox --project=webkit",
    "test:e2e:mobile": "playwright test tests/end-to-end-*.spec.ts --project='Mobile Chrome' --project='Mobile Safari'",
    "test:e2e:debug": "playwright test tests/end-to-end-*.spec.ts --debug",
    "test:e2e:headed": "playwright test tests/end-to-end-*.spec.ts --headed",
    "test:e2e:trace": "playwright test tests/end-to-end-*.spec.ts --trace=on",
    "test:e2e:coverage": "playwright test tests/end-to-end-*.spec.ts --reporter=html"
  },
